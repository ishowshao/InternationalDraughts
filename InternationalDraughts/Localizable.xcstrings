    },
    "Captures are mandatory, and the move capturing the most pieces must be chosen." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳吃为强制，且必须选择吃子最多的走法。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "跳吃為強制，且必須選擇吃子最多的走法。" } }
