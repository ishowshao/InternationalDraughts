{
  "sourceLanguage" : "en",
  "strings" : {
  "Your color (changing starts a new game)": {
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "执子颜色（切换将开始新游戏）"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "執子顏色（切換將開始新遊戲）"
        }
      }
    }
  },
  "Computer (White)": {
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "电脑（白）"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "電腦（白）"
        }
      }
    }
  },
    "Accept" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接受" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "接受" } }
      }
    },
    "A man reaching the far edge becomes a king, which can move and capture over long distances." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "普通子到达底线升变为「王」，可远距离滑行与跳吃。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "普通子到達底線升變為「王」，可遠距離滑行與跳吃。" } }
      }
    },
    "A player with no legal move loses." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无棋可走的一方判负。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無棋可走的一方判負。" } }
      }
    },
    "Black" : {
      "localizations" : {
